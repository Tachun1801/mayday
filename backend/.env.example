NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_ENABLED=false
# Optional for foundation; set privately before implementing DB-backed features.
# DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=verify-full

# Set a random private value of at least 32 bytes to enable authentication.
JWT_SECRET=
# Optional JSON override. Names must match existing DB permissions; unmapped actions deny.
# RBAC_ACTION_PERMISSIONS={"patients.read":["manage_medical_records"]}

# Optional private image storage. Never use VITE_ variables for these secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opt-in patient signup and exact-match first-contact workflow.
# Set privately to the owner-approved existing patient role ID; never accept role from clients.
PATIENT_SIGNUP_ROLE_ID=
